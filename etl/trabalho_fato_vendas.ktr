    <connection>banco_curso</connection>
    <sql>SELECT
    item.id AS id_item_origem,
    nf.id AS id_nota_fiscal_origem,

    TO_CHAR(
        nf.data_venda AT TIME ZONE 'America/Sao_Paulo',
        'YYYYMMDD'
    )::integer AS sk_tempo,

    item.id_produto AS id_produto_origem,
    nf.id_vendedor AS id_vendedor_origem,
    nf.id_forma_pagto AS id_forma_pagamento_origem,

    item.quantidade,
    item.valor_unitario,
    item.valor_venda_real AS valor_total_item

FROM vendas.item_nota_fiscal AS item

JOIN vendas.nota_fiscal AS nf
    ON nf.id = item.id_nota_fiscal;</sql>
    <limit>0</limit>
    <lookup/>
