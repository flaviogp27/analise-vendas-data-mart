    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>banco_curso</connection>
    <sql>WITH limites AS (
    SELECT
        DATE_TRUNC(
            'year',
            MIN(data_venda AT TIME ZONE 'America/Sao_Paulo')
        )::date AS inicio,

        (
            DATE_TRUNC(
                'year',
                MAX(data_venda AT TIME ZONE 'America/Sao_Paulo')
            )
            + INTERVAL '1 year'
            - INTERVAL '1 day'
        )::date AS fim

    FROM vendas.nota_fiscal
),
calendario AS (
    SELECT
        inicio + s.numero AS data
    FROM limites
    CROSS JOIN LATERAL
        GENERATE_SERIES(0, fim - inicio) AS s(numero)
)
SELECT
    TO_CHAR(data, 'YYYYMMDD')::integer AS sk_tempo,
    data,
    EXTRACT(YEAR FROM data)::integer AS ano,
    EXTRACT(QUARTER FROM data)::integer AS trimestre,
    EXTRACT(MONTH FROM data)::integer AS mes,

    CASE EXTRACT(MONTH FROM data)::integer
        WHEN 1 THEN 'Janeiro'
        WHEN 2 THEN 'Fevereiro'
        WHEN 3 THEN 'Março'
        WHEN 4 THEN 'Abril'
        WHEN 5 THEN 'Maio'
        WHEN 6 THEN 'Junho'
        WHEN 7 THEN 'Julho'
        WHEN 8 THEN 'Agosto'
        WHEN 9 THEN 'Setembro'
        WHEN 10 THEN 'Outubro'
        WHEN 11 THEN 'Novembro'
        WHEN 12 THEN 'Dezembro'
    END AS nome_mes,

    EXTRACT(DAY FROM data)::integer AS dia,
    EXTRACT(ISODOW FROM data)::integer AS dia_semana,

    CASE EXTRACT(ISODOW FROM data)::integer
        WHEN 1 THEN 'Segunda-feira'
        WHEN 2 THEN 'Terça-feira'
        WHEN 3 THEN 'Quarta-feira'
        WHEN 4 THEN 'Quinta-feira'
        WHEN 5 THEN 'Sexta-feira'
        WHEN 6 THEN 'Sábado'
        WHEN 7 THEN 'Domingo'
    END AS nome_dia_semana,

    TO_CHAR(data, 'YYYY-MM') AS ano_mes

FROM calendario
ORDER BY data;</sql>
    <limit>0</limit>
